# Resource budget for the astroshop demo on a host shared with a load test.
# 4 vCPU / 15 GiB host: the demo gets at most 1 CPU (on cores 2-3 only) and
# 3 GiB, and the minimum CPU weight (default is 100) so it yields to the load
# test whenever both compete for a core.
[Unit]
Description=Astroshop subtrace demo (resource-capped)

[Slice]
CPUWeight=1
CPUQuota=100%
AllowedCPUs=2-3
IOWeight=1
MemoryHigh=2560M
MemoryMax=3G
MemorySwapMax=0
