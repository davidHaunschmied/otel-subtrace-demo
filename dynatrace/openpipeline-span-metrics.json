[
  {
    "id": "astroshop_subtrace_calls",
    "type": "samplingAwareCounterMetric",
    "description": "Astroshop: calls per endpoint",
    "enabled": true,
    "matcher": "deployment.release_product == \"astroshop-subtrace-demo\" and subtrace.is_root_span == true and isNotNull(endpoint.name)",
    "samplingAwareCounterMetric": {
      "metricKey": "astroshop.subtrace.calls",
      "sampling": "enabled",
      "aggregation": "enabled",
      "dimensions": [
        {
          "sourceFieldName": "deployment.release_product",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "service.name",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "endpoint.name",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "subtrace.user.loyalty_level",
          "extractionType": "field"
        }
      ]
    }
  },
  {
    "id": "astroshop_subtrace_failed_calls",
    "type": "samplingAwareCounterMetric",
    "description": "Astroshop: failed calls per endpoint and propagated error message",
    "enabled": true,
    "matcher": "deployment.release_product == \"astroshop-subtrace-demo\" and subtrace.is_root_span == true and isNotNull(endpoint.name) and subtrace.error_count > 0",
    "samplingAwareCounterMetric": {
      "metricKey": "astroshop.subtrace.failed_calls",
      "sampling": "enabled",
      "aggregation": "enabled",
      "dimensions": [
        {
          "sourceFieldName": "deployment.release_product",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "service.name",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "endpoint.name",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "subtrace.error_message",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "subtrace.user.loyalty_level",
          "extractionType": "field"
        }
      ]
    }
  },
  {
    "id": "astroshop_subtrace_db_calls",
    "type": "valueMetric",
    "description": "Astroshop: database calls per call, per endpoint (N+1)",
    "enabled": true,
    "matcher": "deployment.release_product == \"astroshop-subtrace-demo\" and subtrace.is_root_span == true and isNotNull(endpoint.name) and isNotNull(subtrace.db_call_count)",
    "valueMetric": {
      "metricKey": "astroshop.subtrace.db_calls",
      "field": "subtrace.db_call_count",
      "dimensions": [
        {
          "sourceFieldName": "deployment.release_product",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "service.name",
          "extractionType": "field"
        },
        {
          "sourceFieldName": "endpoint.name",
          "extractionType": "field"
        }
      ]
    }
  }
]
